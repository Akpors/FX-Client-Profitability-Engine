# Copy to .env and set FX_DB_PASSWORD. .env is gitignored; never commit it.
# Every other variable has a default in docker-compose.yml, so FX_DB_PASSWORD is the only required one.

# Postgres connection used by the pipeline and dbt containers.
FX_DB_HOST=db
FX_DB_NAME=fxengine
FX_DB_USER=fxengine
FX_DB_PASSWORD=change_me

# Host ports, bound to 127.0.0.1 only. Defaults avoid 5432 / 8501 / 8888.
# FX_DB_PORT is the host side of the Postgres mapping; containers always use 5432.
FX_DB_PORT=5433
FX_APP_PORT=8502
FX_NOTEBOOK_PORT=8889
FX_DBT_DOCS_PORT=8081
